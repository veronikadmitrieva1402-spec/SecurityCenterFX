<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.controller.EditRequestController"
      spacing="10" prefWidth="400">

    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Редактирование заявки" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Клиент:"/>
    <ComboBox fx:id="clientCombo" prefWidth="350" promptText="Выберите клиента"/>

    <Label text="Адрес объекта:"/>
    <TextField fx:id="addressField" promptText="ул. Ленина, д. 10"/>

    <Label text="Тип охраны:"/>
    <ComboBox fx:id="typeCombo" prefWidth="350" promptText="Выберите тип охраны"/>

    <Label text="Статус заявки:"/>
    <ComboBox fx:id="statusCombo" prefWidth="350"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="15"/></padding>
        <Button text="Сохранить" onAction="#onSave" defaultButton="true"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>